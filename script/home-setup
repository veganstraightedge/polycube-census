#!/usr/bin/env ruby
# frozen_string_literal: true

# Create (or reset) the coordinator database. Usage:
#   script/home-setup [--reset]

require_relative "../lib/census"

url = ENV.fetch("POLYCUBE_HOME_URL", "postgres:///polycube_home")
database = url.split("/").last
system("createdb", database, err: File::NULL)

store = Census::Home::Store.new(url:)
store.load_schema(File.expand_path("../db/home.sql", __dir__))
store.reset if ARGV.include?("--reset")
puts "coordinator database ready: #{url}"
puts store.status.inspect
