#!/usr/bin/env ruby
# frozen_string_literal: true

# Run pipeline stages over unresolved shapes in data/.
#
# Usage:
#   script/census [max_n]                 # everything, one process
#   script/census [max_n] --shard 2/6     # this worker takes every 6th shape,
#                                         # starting at 2 — run one worker per
#                                         # shard (1/6 .. 6/6) in parallel
#   script/census [max_n] --max-volume 128 --max-index 72
#                                         # raised-budget probe of survivors
#
# Shards touch disjoint files, so parallel workers never race.

require_relative "../lib/census"

def option(arguments, flag, default)
  return default unless (position = arguments.index(flag))

  arguments.delete_at(position)
  arguments.delete_at(position)
end

arguments = ARGV.dup
shard_index, shard_count = option(arguments, "--shard", "1/1").split("/").map { Integer(it) }
max_volume = Integer(option(arguments, "--max-volume", Census::BoxSearch::DEFAULT_MAX_VOLUME))
max_index = Integer(option(arguments, "--max-index", Census::TorusSearch::DEFAULT_MAX_INDEX))
max_size = Integer(arguments.fetch(0, "8"))
root = File.expand_path("../data", __dir__)

Census::Pipeline.new(root:, max_index:, max_volume:).run(max_size:, shard_count:, shard_index:) { puts it }
puts "Done through n=#{max_size} (shard #{shard_index}/#{shard_count})"
