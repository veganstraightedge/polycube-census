#!/usr/bin/env ruby
# frozen_string_literal: true

# March-independent cube splitter: rank variables by occurrence count,
# take the top k, emit all 2^k sign combinations as an iCNF cube file.
# Crude next to march's lookahead, but robust at any scale — the cubes
# trivially cover all assignments, so cube-solve's aggregation is sound.
#
# Usage: script/make-cubes <formula.cnf> <k> [output.icnf]

cnf_path = ARGV.fetch(0)
k = Integer(ARGV.fetch(1))
output_path = ARGV.fetch(2, "#{cnf_path}.cubes.icnf")

counts = Hash.new(0)
File.foreach(cnf_path) do |line|
  next if line.start_with?("p", "c")

  line.split.each do |token|
    literal = Integer(token)
    counts[literal.abs] += 1 unless literal.zero?
  end
end

top = counts.max_by(k) { |_, count| count }.map(&:first)
puts "top #{k} variables by occurrence: #{top.inspect}"

File.open(output_path, "w") do |io|
  [1, -1].repeated_permutation(k) do |signs|
    io.puts("a #{top.zip(signs).map { |variable, sign| variable * sign }.join(' ')} 0")
  end
end
puts "wrote #{2**k} cubes to #{output_path}"
