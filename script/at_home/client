#!/usr/bin/env ruby
# frozen_string_literal: true

# A polycubing@home volunteer client. Every option has a default, so the
# whole thing is: script/at_home/client
#
#   --url URL              coordinator address    (default $POLYCUBE_AT_HOME
#                                                  or http://127.0.0.1:9292)
#   --handle HANDLE        permanent scheduling id, opaque and never
#                          displayed  (default client-<hostname>-<pid>)
#   --name NAME            display name for credits — subject to approval
#                          before it appears in data/  (default: none, and
#                          credit falls back to the handle)
#   --contact CONTACT      how to reach you, if you want to be reachable
#   --limit N              stop after N units          (default: no limit)
#   --once                 stop when the queue is empty rather than waiting
#   --give-up-after SECS   stop if the coordinator stays unreachable this
#                          long  (default: wait indefinitely)
#
# Holds no census state: leases a unit, solves it locally, returns the answer.
# Everything it returns is re-verified by the coordinator.

require_relative "../../lib/census"
require "socket"

arguments = ARGV.dup

def option(arguments, flag, default)
  return default unless (position = arguments.index(flag))

  arguments.delete_at(position)
  arguments.delete_at(position)
end

def flag?(arguments, flag)
  return false unless (position = arguments.index(flag))

  arguments.delete_at(position)
  true
end

handle = option(arguments, "--handle", "client-#{Socket.gethostname}-#{Process.pid}")
display_name = option(arguments, "--name", nil)
url = option(arguments, "--url", ENV.fetch("POLYCUBE_AT_HOME", "http://127.0.0.1:9292"))
contact = option(arguments, "--contact", nil)
limit = option(arguments, "--limit", nil)&.then { Integer(it) }
once = flag?(arguments, "--once")
give_up_after = option(arguments, "--give-up-after", nil)&.then { Integer(it) }

client = Census::AtHome::Client.new(url:, handle:, display_name:, contact:, give_up_after:,
                                    report: ->(line) { puts "#{Time.now.utc.iso8601}  #{line}" })
tally = begin
  client.run(limit:, once:)
rescue Interrupt
  puts
  puts "stopped by request"
  {}
end
puts "done: #{tally.sort.to_h.inspect}"
puts
