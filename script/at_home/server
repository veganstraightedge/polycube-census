#!/usr/bin/env ruby
# frozen_string_literal: true

# Boot the polycubing@home coordinator.
#
#   script/at_home/server [--port 9292] [--threads 16]
#
# A thin wrapper over `puma -C config/puma.rb`, which loads config.ru — use
# either; they are the same server. Database: $POLYCUBE_AT_HOME_URL,
# default postgres:///polycube_at_home (create it with script/at_home/setup).

arguments = ARGV.dup

def option(arguments, flag, default)
  return default unless (position = arguments.index(flag))

  arguments.delete_at(position)
  arguments.delete_at(position)
end

ENV["PORT"] = option(arguments, "--port", ENV.fetch("PORT", "9292"))
ENV["AT_HOME_THREADS"] = option(arguments, "--threads", ENV.fetch("AT_HOME_THREADS", "16"))

Dir.chdir(File.expand_path("../..", __dir__)) do
  exec("bundle", "exec", "puma", "-C", "config/puma.rb")
end
