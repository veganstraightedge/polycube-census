#!/usr/bin/env ruby
# frozen_string_literal: true

# Create (or reset) the coordinator server development database
# Usage:
#   script/at_home/setup
#
# Options.
#
#   --reset               wipe the database and start fresh
#
# Examples:
#
#   script/at_home/setup
#   script/at_home/setup --reset

require_relative '../../lib/census'

url    = ENV.fetch 'POLYCUBE_AT_HOME_URL', 'postgres:///polycube_at_home'
schema = File.expand_path '../../db/at_home.sql', __dir__

# The test database exists so that `script/test` can truncate freely
# without touching a live queue; keep both in step
[url, 'postgres:///polycube_at_home_test'].uniq.each do |database_url|
  system 'createdb', database_url.split('/').last, err: File::NULL

  store = Census::AtHome::Store.new url: database_url
  store.load_schema schema

  if ARGV.include?('--reset') && database_url == url
    store.reset
  end

  puts 'ready: #{database_url}  #{store.status[:units].inspect}'
  puts

  store.close
end
